{
  "$schema": "https://schemas.runtipi.io/v2/dynamic-compose.json",
  "services": [
    {
      "name": "papra",
      "image": "ghcr.io/papra-hq/papra:latest",
      "isMain": true,
      "internalPort": 1221,
      "user": "1000:1000",
      "environment": {
        "AUTH_SECRET": "${PAPRA_AUTH_SECRET}",
        "APP_BASE_URL": "${PAPRA_APP_BASE_URL:-http://localhost:1221}",
        "AUTH_IS_REGISTRATION_ENABLED": "${PAPRA_AUTH_IS_REGISTRATION_ENABLED:-true}"
      },
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/app-data",
          "containerPath": "/app/app-data"
        }
      ]
    }
  ],
  "schemaVersion": 2
}
